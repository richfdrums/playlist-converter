{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playlist-converter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // SPA: unknown paths (e.g. /callback, /share) serve index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is a static asset.
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  // Secrets (set with `npx wrangler secret put <NAME>`, or .dev.vars locally):
  //   TIDAL_CLIENT_ID, TIDAL_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, YOUTUBE_API_KEY
}
